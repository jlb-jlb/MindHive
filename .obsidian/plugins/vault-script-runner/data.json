      "id": "clean-chatgpt-research",
      "name": "Clean ChatGPT research report",
      "version": "0.1.1",
      "fileName": "clean_gpt_research.py",
      "sourceUrl": "https://raw.githubusercontent.com/jlb-jlb/vault-script-runner/main/catalog/clean_gpt_research.py",
